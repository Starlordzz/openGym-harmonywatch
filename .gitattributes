# Text sources use the same bytes on Linux, WSL and Windows.
* text=auto eol=lf

# Shell scripts and container files keep Unix line endings on every checkout, Windows included:
# a CRLF in a script's #! line makes the container report "not found" at start-up (#1025).
*.sh text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
frontend/android/gradlew text eol=lf

# Preserve the official SDK archive bytes for integrity verification.
frontend/harmony/watch/entry/src/main/js/default/vendor/** -text
harmonywatch/entry/src/main/js/MainAbility/vendor/** -text
